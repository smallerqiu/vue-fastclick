{
  "name": "vue-fastclick",
  "version": "1.1.0",
  "description": "Polyfill to remove click delays on browsers with touch UIs. Only needed for old iOS / old WebViews; modern browsers should use touch-action: manipulation",
  "main": "index.js",
  "module": "index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "index.js",
    "index.mjs",
    "index.d.ts",
    "LICENSE",
    "readme.md"
  ],
  "scripts": {
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smallerqiu/vue-fastclick.git"
  },
  "keywords": [
    "fastclick",
    "vue-fastclick",
    "mobile",
    "touch",
    "tap",
    "click",
    "delay",
    "zoom"
  ],
  "author": "Qiu /smallerqiu@gmail.com",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/smallerqiu/vue-fastclick/issues"
  },
  "homepage": "https://github.com/smallerqiu/vue-fastclick#readme",
  "devDependencies": {
    "jsdom": "^30.1.3",
    "vitest": "^5.0.5"
  }
}
